{
	# Use Caddy's internal CA (no public ACME); the client skips verification.
	local_certs
	auto_https disable_redirects
}

# A named site so Caddy issues an internal cert matching the SNI the client
# sends, and serves HTTP/3 on :443 (UDP).
h3caddy:443, localhost:443, lossproxy:443 {
	tls internal
	root * /srv

	# Fixed status codes for the status-pass-through test (A3).
	@s204 path /status/204
	handle @s204 {
		respond 204
	}
	@s304 path /status/304
	handle @s304 {
		respond 304
	}
	@s404 path /status/404
	handle @s404 {
		respond "not found" 404
	}
	@s500 path /status/500
	handle @s500 {
		respond "boom" 500
	}

	# /sink is the upload target for the congestion-control benchmark. It MUST
	# go through reverse_proxy: `respond` and `file_server` both answer without
	# reading the request body, which is exactly the bug in #564 — the timer
	# closed on the response while the payload was still buffered. reverse_proxy
	# has to forward the bytes, so the upload becomes real.
	@sink path /sink
	handle @sink {
		reverse_proxy sink:8080
	}

	# "/" (and a POST to it) get a small canned response; other paths are served
	# from /srv (e.g. /big.txt, a 16 KiB body for the large-response test).
	@root path /
	handle @root {
		respond "hello from http3" 200
	}
	handle {
		file_server
	}
}
