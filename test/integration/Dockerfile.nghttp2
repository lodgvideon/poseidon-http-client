FROM alpine:3.20 AS builder

RUN apk add --no-cache \
    build-base cmake autoconf automake libtool git \
    openssl-dev openssl-libs-static zlib-dev zlib-static \
    c-ares-dev libev-dev libevent-dev jansson-dev \
    libxml2-dev boost-dev brotli-dev

RUN git clone --depth=1 --branch v1.68.0 https://github.com/nghttp2/nghttp2.git /nghttp2

WORKDIR /nghttp2

RUN git submodule update --init --depth=1

RUN autoreconf -i && \
    ./configure \
        --disable-examples \
        --disable-hpack-tools \
        --disable-python-bindings \
        --enable-app \
        --with-openssl \
        --without-jemalloc && \
    make -j$(nproc) && \
    make install

FROM alpine:3.20

# libssl3 + libcrypto3, not "openssl-libs": Alpine has never had a package by
# that name, so this stage could not build. It went unnoticed because no compose
# service referenced this Dockerfile until now.
RUN apk add --no-cache \
    libssl3 libcrypto3 zlib libev libevent jansson libxml2 \
    c-ares brotli libstdc++ wget

COPY --from=builder /usr/local/bin/nghttpx /usr/local/bin/nghttpx
# nghttpx links against the libnghttp2 the builder stage just installed, which
# lives in the builder and not in Alpine's repositories. Without it the binary
# builds, ships, and dies on start with ~60 "symbol not found" relocations --
# every one of them an nghttp2_* symbol. musl's default search path includes
# /usr/local/lib, so no ldconfig is needed.
COPY --from=builder /usr/local/lib/libnghttp2.so* /usr/local/lib/

ENTRYPOINT ["nghttpx"]
