# Binaries
*.exe
*.test
*.out

# Coverage
coverage.txt
cover.out

# Bench artifacts
head.txt
base.txt
diff.txt

# Mutation report (`make mutation-full`); CI keeps it as a job artifact
gremlins.json

# Fuzz corpus: deliberately NOT ignored. Go's generated corpus lives in
# $GOCACHE/fuzz, not here — the only thing `go test` writes under
# testdata/fuzz/<Target>/ is a crasher, which MUST be committed: it is the
# regression seed the `go test -run=Fuzz` replay in CI reruns forever.

# IDE
.vscode/
.idea/

# Local tooling caches (LSP indexes, hook state)
.serena/
.claude/tdd-guard/data/
.claude/worktrees/

# OS
.DS_Store

# Integration test certs (generated by gen-certs.sh)
test/integration/fixtures/certs/

# HTTP/3 interop: 1 MiB throughput fixture generated by the compose init service
test/integration/http3/srv/huge.txt

# Maven build output
test/integration/undertow-server/target/
test/integration/undertow-server/bin/

# Eclipse project metadata (Maven users don't need .project/.classpath)
test/integration/undertow-server/.project
test/integration/undertow-server/.classpath
test/integration/undertow-server/.settings/

# Codesearch index
.codesearch.db/

# Runtime logs
.logs/

# fault server test binary (built by go run/build in the container)
test/integration/http3/faultserver/faultserver
test/integration/http3/faultserver/faultserver.exe

# Agent/tooling local artifacts
.logs/
.opencode/

# Hugo build output
website/public/
website/resources/

# Agent chain artifacts
.claude/chain/
website/.hugo_build.lock
scripts/.rfc-cache/
