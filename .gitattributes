# gofmt emits LF and only LF. With a CRLF working tree (git's autocrlf on
# Windows) every file reads as unformatted locally, so the gofmt gate in
# .golangci.yml can only ever be checked on CI — and any file a Windows editor
# rewrites lands CRLF in the index and fails that gate. Pin the working tree to
# LF for everything the build, the gate, or CI's bash actually reads.
#
# The fuzz corpora under */testdata/fuzz/ are Go-quoted text (escapes, never a
# raw CR), so normalizing them is safe — and it fixes a local-only trap: Go's
# corpus parser is line-oriented, and a CRLF checkout appends \r to every seed.
* text=auto

*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf

# The file that pins LF should not itself be checked out as CRLF; same for the
# other dotfiles CI reads.
.gitattributes text eol=lf
.gitignore     text eol=lf
.dockerignore  text eol=lf
